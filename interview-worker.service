[Unit]
Description=RQ worker for interview report generation
After=network.target redis-server.service interview.service
Wants=redis-server.service
PartOf=interview.service

[Service]
User=root
Group=root
WorkingDirectory=/root/projects/interview
Environment="PATH=/root/projects/interview/venv/bin"
Environment="PYTHONPATH=/root/projects/interview"
EnvironmentFile=-/root/projects/interview/.env
Environment="APP_ENV=production"
Environment="REPORT_QUEUE_MODE=rq"
ExecStart=/root/projects/interview/venv/bin/python worker.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
