APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5001
FLASK_DEBUG=1
USE_RELOADER=True
DATABASE_URL=sqlite:///app.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash
LLM_REPORT=deepseek-flash
VLM_MODEL_NAME=deepseek-flash
LLM_THINKING=disabled
# 本地 SenseVoice 识别；先运行 python scripts/prepare_local_asr.py。
# ASR_MODEL_DIR 默认使用项目内 .local/asr/sensevoice，支持绝对路径覆盖。
ASR_LANGUAGE=auto
ASR_NUM_THREADS=2
VOLC_APPID=
VOLC_ACCESS_TOKEN=

# auto: development prefers RQ and falls back to a local thread.
# rq: production-grade durable queue; Redis is required and no thread fallback occurs.
# thread: explicit local-only mode.
REPORT_QUEUE_MODE=auto
REDIS_URL=redis://127.0.0.1:6379/0
REPORT_QUEUE_NAME=interview_reports
REPORT_JOB_TIMEOUT_SECONDS=600
REPORT_JOB_RESULT_TTL_SECONDS=86400
REPORT_JOB_FAILURE_TTL_SECONDS=604800
REPORT_RETRY_INTERVALS=30,120

# Interview / WikiBook account association; use the same random >=32-character
# secret in BOTH servers. Local loopback HTTP and the exact production Interview
# origin below are supported; other public origins must use HTTPS.
ACCOUNT_LINK_INTERVIEW_URL=http://211.154.20.65:20018
ACCOUNT_LINK_WIKIBOOK_URL=
ACCOUNT_LINK_SECRET=
# Must match the timezone used to write historical naive business timestamps.
INTERVIEW_RECORD_TIMEZONE=Asia/Shanghai
